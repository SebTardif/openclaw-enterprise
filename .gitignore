# Local secrets must never be staged or archived.
.env
.env.*
!.env.example

# Dependency trees and generated artifacts remain machine-local at every depth.
node_modules/
dist/
coverage/
*.log
.DS_Store
playwright-report/
test-results/
.playwright-cli/
output/playwright/

# Agent-local progress is not product source.
.agents/*
!.agents/skills/
.agents/skills/*
!.agents/skills/autoreview/
!.agents/skills/LICENSE.agent-skills
!.agents/skills/test-audit/
!.agents/skills/deslop/
!.agents/skills/enterprise-testing/
!.agents/skills/LICENSE.openclaw
__pycache__/
*.pyc
.vscode/settings.json

# Developer-specific mise overrides stay outside the shared toolchain.
mise.local.toml
mise.local.lock

# Keep the testing guide visible when a global ignore matches its name.
!/docs/testing.md
